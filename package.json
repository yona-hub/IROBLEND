{
  "name": "iroblend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run recipes:check && tsc -b && vite build",
    "recipes:generate": "node scripts/run-reverse-tools.mjs scripts/generate-reverse-recipes.ts",
    "recipes:check": "node scripts/run-reverse-tools.mjs scripts/check-reverse-recipes.ts",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "audit:colors": "vite-node scripts/audit-colors.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "spectral.js": "3.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.143.0"
  }
}
